# Prompt Enhancer is intended to be public. Real conversations and provider state
# must never enter the repository, even temporarily.

# Secrets and credentials
.env
.env.*
!.env.example
.secrets/
secrets/
*.pem
*.key
*.p12
*.pfx
*.jks
auth.json
credentials.json

# Personal Codex / Claude state and project-local overrides
/.codex/
/.claude/
CLAUDE.local.md
*.local.md

# Raw, imported, exported, or private conversation data
/data/
/runtime/
/var/
/logs/
/exports/
/artifacts/private/
history.jsonl
sessions/
archived_sessions/
*.transcript.json
*.transcript.jsonl
*.ndjson

